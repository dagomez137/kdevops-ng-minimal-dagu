# SPDX-License-Identifier: copyleft-next-0.3.1
#
# Read twice in the guest: by fstests as its HOST_OPTIONS file, and by
# fstests.service as its EnvironmentFile (devices to format). steps/fstests/run
# appends FSTESTS_ARGS, the tests to run.
FSTYP=xfs
TEST_DEV=/dev/nvme0n1
TEST_DIR=/mnt/test
SCRATCH_DEV=/dev/nvme1n1
SCRATCH_MNT=/mnt/scratch
RESULT_BASE=/var/lib/xfstests/results
