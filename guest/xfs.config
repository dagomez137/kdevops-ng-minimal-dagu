# SPDX-License-Identifier: copyleft-next-0.3.1
#
# kdevops-ng's XFS section catalog, as xfs_catalog_text() in its
# f/fstests/common.py prints it. steps/fstests/render copies one section per
# run into the xfstests share and binds it to the guest's disks.

[xfs_bs1k_ss512]
FSTYP=xfs
MKFS_OPTIONS="-b size=1024 -s size=512"

[xfs_bs1k_ss1k]
FSTYP=xfs
MKFS_OPTIONS="-b size=1024 -s size=1024"

[xfs_bs2k_ss512]
FSTYP=xfs
MKFS_OPTIONS="-b size=2048 -s size=512"

[xfs_bs2k_ss1k]
FSTYP=xfs
MKFS_OPTIONS="-b size=2048 -s size=1024"

[xfs_bs2k_ss2k]
FSTYP=xfs
