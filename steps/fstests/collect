#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/fstests/collect --section NAME --share DIR --kver RELEASE
##            --notrun FILE --output FILE
##
## Read the xunit report check wrote for section NAME under
## DIR/RELEASE/results/NAME, or the testcases appended to testcases.xml
## there when check never finished, write the section's summary with its
## failed and slowest tests and the tests the guest died in next to it as
## report.md, print it and append verdict=passed|failed to FILE. The
## section passed when steps/fstests/start's last outcome there is
## finished, the report is there, a test ran, none failed and none was
## skipped that the "section test reason" lines of FILE do not list for
## NAME (any skip passes when FILE is empty or has no line for NAME); a
## test failed when any of its passes did, and did not run when every pass
## skipped it. Exit 1 unless it passed. kdevops-ng's f/fstests/collect.py:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/fstests/collect --section xfs_bs4k_ss4k \
##       --share ~/.local/state/qemu-system/fstests-1/xfstests --kver 7.2.11 \
##       --notrun guest/xfs.notrun --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--section | --share | --kver | --notrun | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${section:?} ${share:?} ${kver:?} ${notrun?} ${output:?}"

dir=$share/$kver/results/$section
report=$dir/result.xml
set -o xtrace
mkdir --parents "$dir"
outcome=$(cat "$dir/outcome" 2>/dev/null) || outcome='never started'
if [ "$outcome" = finished ] && [ ! -s "$report" ]; then
	summary='failed: no xunit report, check did not finish'
elif [ ! -s "$report" ] && [ ! -s "$dir/testcases.xml" ]; then
	summary="failed: the run was $outcome before a test finished"
else
	[ -s "$report" ] || report=$dir/testcases.xml
	# check writes one <testcase> line per test and pass (common/report), its
	# <failure> or <skipped> on the lines after it.
	summary=$(awk --assign section="$section" --assign notrun="$notrun" \
		--assign outcome="$outcome" '
		BEGIN {
			while (notrun != "" && (getline line <notrun) > 0)
				if (split(line, f, " ") > 1 && f[1] == section) listed = expected[f[2]] = 1
		}
		/<testcase / && match($0, / name="[^"]*"/) {
			name = substr($0, RSTART + 7, RLENGTH - 8)
			if (!(name in passes)) order[++n] = name
			passes[name]++
		}
		/<failure/ { failed[name] = 1 }
		/<skipped/ && match($0, /message="[^"]*"/) {
			skipped[name]++
			reason[name] = substr($0, RSTART + 9, RLENGTH - 10)
		}
		END {
			for (i = 1; i <= n; i++) {
				t = order[i]
				if (t in failed) { nfail++; fails = fails " " t }
				else if (skipped[t] == passes[t]) {
					nskip++
					if (listed && !(t in expected))
						unexpected = unexpected sprintf("\n  %s: %s", t, reason[t])
				} else {
					npass++
					if (t in expected) ran = ran " " t
				}
			}
			printf "%s: %d tests, %d passed, %d failed, %d not run%s%s\n",
				nfail || !npass || unexpected != "" || outcome != "finished" ? "failed" : "passed",
				n, npass, nfail, nskip, npass || nfail ? "" : ", none ran",
				outcome == "finished" ? "" : ", the last attempt " outcome
			if (nfail) print "Failures:" fails
			if (unexpected != "") print "Not run, not expected to skip:" unexpected
			if (ran != "") print "Ran, expected to skip:" ran
		}' "$report")
	# Each test at its slowest pass.
	slowest=$(awk '
		/<testcase / && match($0, / name="[^"]*"/) {
			name = substr($0, RSTART + 7, RLENGTH - 8)
			match($0, /time="[^"]*"/); time = substr($0, RSTART + 6, RLENGTH - 7)
			if (!(name in slow) || time + 0 > slow[name]) slow[name] = time + 0
		}
		END { for (name in slow) print slow[name], name }' "$report" |
		sort --numeric-sort --reverse | sed --quiet 1,10p)
	summary="$summary"$'\n'"Slowest:"$'\n'"$slowest"
fi
if [ -s "$dir/crashes" ]; then
	summary="$summary"$'\n'"The guest died in:"$'\n'"$(sed 's/^/  /' "$dir/crashes")"
fi
verdict=${summary%%:*}
{
	echo "### fstests \`$section\`"
	echo '```'
	echo "$summary"
	echo '```'
} >"$dir/report.md"
cat "$dir/report.md"
echo "verdict=$verdict" >>"$output"
[ "$verdict" = passed ]
