#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/fstests/discover --key FILE --cid CID --tests TESTS --output FILE
##
## Check that the guest at vsock CID CID carries xfstests@.service, fstests'
## check and each test in the list TESTS, and append to FILE its kernel
## release (kver=), its NVMe disks in order (devices=/dev/nvme0n1 ...) and
## their largest logical sector size (sector=). Fail with fewer than two
## disks. kdevops-ng's f/fstests/discover.py:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/fstests/discover \
##       --key ~/.local/state/kdevops-ng-minimal-dagu/ssh/id_ed25519 --cid 4242 \
##       --tests 'generic/001 generic/002' --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--key | --cid | --tests | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${key:?} ${cid:?} ${tests?} ${output:?}"

ssh=("$(dirname "$0")/../qsu/ssh" --key "$key" --cid "$cid" --)
read -r -a list <<<"$tests"
set -o xtrace
"${ssh[@]}" systemctl cat xfstests@.service >/dev/null
"${ssh[@]}" test -x /usr/lib/xfstests/check
# check stashes a test it cannot find as passed; refuse the name here.
if [ "${#list[@]}" -gt 0 ]; then
	"${ssh[@]}" ls --directory "${list[@]/#//usr/lib/xfstests/tests/}" >/dev/null
fi
kver=$("${ssh[@]}" cat /proc/sys/kernel/osrelease)
disks=$("${ssh[@]}" lsblk --nodeps --noheadings --output NAME,TYPE,LOG-SEC |
	awk '$1 ~ /^nvme[0-9]+n1$/ && $2 == "disk" { print $1, $3 }' | sort --version-sort)
devices=$(awk '{ printf "%s/dev/%s", (NR > 1 ? " " : ""), $1 }' <<<"$disks")
sector=$(awk '$2 > s { s = $2 } END { print s ? s : 512 }' <<<"$disks")
if [ "$(wc --words <<<"$devices")" -lt 2 ]; then
	echo "need two NVMe disks for TEST_DEV and SCRATCH_DEV, found: $devices" >&2
	exit 1
fi
{
	echo "kver=$kver"
	echo "devices=$devices"
	echo "sector=$sector"
} >>"$output"
