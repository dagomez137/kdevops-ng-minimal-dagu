#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/fstests/judge --report FILE
##
## Fail unless every section in the report steps/fstests/report wrote,
## FILE, is complete: every guest ran it to the end. Failed tests do not
## fail the run; the report lists them. kdevops-ng's f/fstests/judge.py:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/fstests/judge \
##       --report ~/.local/state/kdevops-ng-minimal-dagu/report.md
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--report) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${report:?}"

set -o xtrace
# Each section's summary line opens with complete: or incomplete:.
if grep '^incomplete:' "$report"; then
	exit 1
fi
grep --quiet '^complete:' "$report"
