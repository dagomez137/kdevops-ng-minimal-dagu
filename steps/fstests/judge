#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/fstests/judge --outcomes FILE
##
## Fail unless the run steps/fstests/report wrote FILE for is complete:
## every guest ran each section to the end and skipped only what the
## notrun list expects. Failed tests do not fail the run; the report lists
## them. kdevops-ng's f/fstests/judge.py:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/fstests/judge \
##       --outcomes ~/.local/state/kdevops-ng-minimal-dagu/report/outcomes
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--outcomes) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${outcomes:?}"

set -o xtrace
grep --quiet --line-regexp 'status=complete' "$outcomes"
