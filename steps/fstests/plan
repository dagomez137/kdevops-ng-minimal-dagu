#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/fstests/plan --vms V --shard [I/N] --state DIR --output FILE
##
## Split this host's share of a run among V guests: guest J (named
## fstests-J) takes shard (I-1)*V+J of N*V, J of V when the shard is empty,
## or the whole run for one guest and no shard, and leaves its results on
## its xfstests share DIR/fstests-J/xfstests. The share's kver file goes
## first, so that a guest that fails before steps/fstests/render writes it
## again leaves none for steps/fstests/report to read. Append guests=<a
## JSON list of {vm, shard}> and shares=<those shares> to FILE:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/fstests/plan --vms 2 --shard 1/6 \
##       --state ~/.local/state/qemu-system --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--vms | --shard | --state | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${vms:?} ${shard?} ${state:?} ${output:?}"

if ! [[ $vms =~ ^[1-9][0-9]*$ ]]; then
	echo "--vms takes a count from 1, not '$vms'" >&2
	exit 2
fi
index=1 count=1
if [ -n "$shard" ]; then
	if ! [[ $shard =~ ^([0-9]+)/([0-9]+)$ ]] || [ "${BASH_REMATCH[1]}" -lt 1 ] ||
		[ "${BASH_REMATCH[1]}" -gt "${BASH_REMATCH[2]}" ]; then
		echo "--shard takes I/N with 1 <= I <= N, not '$shard'" >&2
		exit 2
	fi
	index=${BASH_REMATCH[1]} count=${BASH_REMATCH[2]}
fi

set -o xtrace
guests=$(jq --null-input --compact-output --argjson vms "$vms" --argjson index "$index" \
	--argjson count "$count" --arg shard "$shard" '[range(1; $vms + 1) | {
	vm: "fstests-\(.)",
	shard: (if $shard == "" and $vms == 1 then ""
		else "\(($index - 1) * $vms + .)/\($count * $vms)" end)
}]')
shares=$(jq --raw-output --arg state "$state" \
	'[.[] | "\($state)/\(.vm)/xfstests"] | join(" ")' <<<"$guests")
read -r -a list <<<"$shares"
rm --force "${list[@]/%//kver}"
{
	echo "guests=$guests"
	echo "shares=$shares"
} >>"$output"
