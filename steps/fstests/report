#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/fstests/report --files PATHS --output FILE
##
## Join the summaries in PATHS, which steps/fstests/collect wrote for each
## section or this step wrote for each guest, into FILE and print it. A
## missing summary is a section or guest that did not get that far, and
## FILE says it failed. kdevops-ng's f/fstests/report.py:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/fstests/report \
##       --files ~/.local/state/qemu-system/fstests-1/xfstests/7.2.11/results/xfs_bs4k_ss4k/report.md \
##       --output ~/.local/state/qemu-system/fstests-1/xfstests/report.md
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--files | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${files:?} ${output:?}"

set -o xtrace
for file in $files; do
	if [ -s "$file" ]; then
		cat "$file"
	else
		printf '### `%s`\n```\nfailed: never written\n```\n' "$file"
	fi
done >"$output"
cat "$output"
