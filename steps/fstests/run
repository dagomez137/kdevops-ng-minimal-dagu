#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/fstests/run --name VM --config FILE --tests ARGS --state DIR
##            --output FILE
##
## Lay CONFIG down on the xfstests share in DIR with ARGS as the arguments
## to fstests' check, create two empty NVMe drives, boot qemu-system@VM.service
## and follow the guest's console while it runs fstests and powers off. Keep
## the console in DIR/xfstests/console.log and a summary with the slowest tests
## in DIR/xfstests/report.md, print both, append results=<dir> and
## report=<file> to OUTPUT and fail unless fstests.service succeeded in the
## guest:
##
##   nix develop --ignore-env --keep-env-var HOME --keep-env-var XDG_RUNTIME_DIR \
##       --command steps/fstests/run --name fstests \
##       --config guest/fstests.config --tests '-g quick' \
##       --state ~/.local/state/qemu-system/fstests \
##       --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --config | --tests | --state | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?} ${config:?} ${tests:?} ${state:?} ${output:?}"

set -o xtrace
rm --recursive --force "$state/xfstests" "$state/nvme0.raw" "$state/nvme1.raw"
mkdir --parents "$state/xfstests"
cp "$config" "$state/xfstests/fstests.config"
printf 'FSTESTS_ARGS="%s"\n' "$tests" >>"$state/xfstests/fstests.config"
truncate --size 16G "$state/nvme0.raw" "$state/nvme1.raw"

unit=qemu-system@$name.service
since=$(date +%s)
systemctl --user start "$unit"
# Follow the guest's console while it runs. The scope is bound to the VM, so
# systemd stops journalctl when QEMU exits, and journalctl prints what the
# journal still holds before it does.
systemd-run --user --scope --quiet --collect \
	--property BindsTo="$unit" --property After="$unit" \
	journalctl --follow --synchronize-on-exit=yes --user-unit "$unit" \
	--since "@$since" --output cat --no-pager |
	tee "$state/xfstests/console.log" || true

# The kernel logs "run fstests <test> at <date>" as each test starts; a test
# lasts until the next one starts.
starts=$(sed --quiet --regexp-extended \
	's/^\[ *([0-9.]+)\] run fstests ([^ ]+) at .*/\1 \2/p' "$state/xfstests/console.log")
{
	echo "### fstests \`$tests\`"
	echo '```'
	grep --extended-regexp '^(Ran|Not run|Failures|Failed|Passed)' \
		"$state/xfstests/results/check.log" | cut --characters=1-400 ||
		echo 'no check.log: fstests did not finish'
	awk 'NF && !n++ { first = $1 } NF { last = $1 } END {
		printf "%d tests started over %d s\n", n, last - first }' <<<"$starts"
	echo 'Slowest:'
	awk 'NR > 1 { printf "%d %s\n", $1 - t, name } { t = $1; name = $2 }' <<<"$starts" |
		sort --numeric-sort --reverse | head --lines 10
	echo '```'
} >"$state/xfstests/report.md"
cat "$state/xfstests/report.md"

echo "results=$state/xfstests/results" >>"$output"
echo "report=$state/xfstests/report.md" >>"$output"
read -r result _ <"$state/xfstests/status"
[ "$result" = success ]
