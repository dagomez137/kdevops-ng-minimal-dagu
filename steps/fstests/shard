#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/fstests/shard --key FILE --cid CID --fstype FSTYPE
##            --groups GROUPS --tests TESTS --shard I/N --times FILE
##            --output FILE
##
## Pick shard I of N of a run, so N hosts or guests share it. With an empty
## shard, append groups=GROUPS and tests=TESTS to FILE unchanged. Otherwise
## take the test list TESTS, or expand GROUPS (auto when both are empty)
## into the generic and FSTYPE tests the guest at vsock CID CID carries, as
## check -g does from each tests/<dir>/group.list, deal them longest first to the shard with the
## least time so far, by the seconds in the check.time-format FILE (10 for
## a test it lacks, plus 1 for each test's setup), and append groups= and
## tests=<shard I's tests> to FILE:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/fstests/shard \
##       --key ~/.local/state/kdevops-ng-minimal-dagu/ssh/id_ed25519 --cid 4242 \
##       --fstype xfs --groups auto --tests '' --shard 1/4 --times guest/xfs.times \
##       --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--key | --cid | --fstype | --groups | --tests | --shard | --times | --output)
		declare "${1#--}=$2"
		;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${key:?} ${cid:?} ${fstype:?} ${groups?} ${tests?} ${shard?} ${times:?} ${output:?}"

if [ -z "$shard" ]; then
	printf 'groups=%s\ntests=%s\n' "$groups" "$tests" >>"$output"
	exit 0
fi
if ! [[ $shard =~ ^([0-9]+)/([0-9]+)$ ]] || [ "${BASH_REMATCH[1]}" -lt 1 ] ||
	[ "${BASH_REMATCH[1]}" -gt "${BASH_REMATCH[2]}" ]; then
	echo "--shard takes I/N with 1 <= I <= N, not '$shard'" >&2
	exit 2
fi
index=${BASH_REMATCH[1]} count=${BASH_REMATCH[2]}

ssh=("$(dirname "$0")/../qsu/ssh" --key "$key" --cid "$cid" --)
set -o xtrace
if [ -n "$tests" ]; then
	read -r -a list <<<"$tests"
	all=$(printf '%s\n' "${list[@]}")
else
	all=$(for dir in generic "$fstype"; do
		"${ssh[@]}" cat "/usr/lib/xfstests/tests/$dir/group.list" |
			awk -v dir="$dir" -v groups="${groups:-auto}" '
				BEGIN { n = split(groups, want, /[ ,]+/) }
				/^[0-9]/ { for (i = 2; i <= NF; i++) for (j = 1; j <= n; j++)
					if ($i == want[j]) { print dir "/" $1; next } }'
	done)
fi
picked=$(awk 'NR == FNR { if (!/^#/) time[$1] = $2; next }
	{ print ($0 in time ? time[$0] : 10) + 1, $0 }' "$times" - <<<"$all" |
	sort --key=1,1nr --key=2,2 |
	awk -v index_="$index" -v count="$count" '
		{ min = 1; for (i = 2; i <= count; i++) if (load[i] < load[min]) min = i
		  load[min] += $1; if (min == index_) list = list (n++ ? " " : "") $2 }
		END { for (i = 1; i <= count; i++) printf "shard %d/%d: %d s\n", i, count, load[i] > "/dev/stderr"
		      print list }')
echo "shard $shard: $(wc --words <<<"$picked") of $(wc --lines <<<"$all") tests"
printf 'groups=\ntests=%s\n' "$picked" >>"$output"
