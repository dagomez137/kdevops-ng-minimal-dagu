#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/kernel/build --src SRC --config DEFCONFIG --dir DIR --index INDEX
##            --output FILE
##
## Build the Linux tree SRC in place from DEFCONFIG, changes to tracked files
## included, gather the image and the modules in DIR/out, add them to the
## Nix store, keep them as INDEX/kernel-<identity> and append
## kernel=<store path> to FILE. The identity hashes all that fixes the
## bytes: the tree, DEFCONFIG, this script and the devShell's PATH, which
## names the toolchain; a kernel already under INDEX is not built again.
## Run it in the kernel devShell:
##
##   nix develop --ignore-env --keep-env-var HOME .#kernel \
##       --command steps/kernel/build \
##       --src ~/.local/state/kdevops-ng-minimal-dagu/src/linux \
##       --config kernel/imageless_defconfig \
##       --dir ~/.local/state/kdevops-ng-minimal-dagu/linux \
##       --index ~/.local/state/kdevops-ng-minimal-dagu/index --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--src | --config | --dir | --index | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${src:?} ${config:?} ${dir:?} ${index:?} ${output:?}"

set -o xtrace
# The tree as git would commit it now, without touching the real index.
staging=$(mktemp)
cp "$(git -C "$src" rev-parse --path-format=absolute --git-path index)" "$staging"
GIT_INDEX_FILE=$staging git -C "$src" add --update
tree=$(GIT_INDEX_FILE=$staging git -C "$src" write-tree)
rm "$staging"
identity=$(printf '%s\n' "$tree" "$(sha256sum <"$config")" "$(sha256sum <"$0")" "$PATH" |
	sha256sum | cut --characters=1-16)
if kernel=$(readlink --canonicalize-existing "$index/kernel-$identity"); then
	echo "kernel=$kernel" >>"$output"
	exit 0
fi

rm --recursive --force "$dir"
mkdir --parents "$dir/out"
cp "$config" "$src/.config"

# The same tree and config give the same bytes on any host and any day; a
# signing key would be generated afresh by every build, and lockdown selects
# module signing. The release names no commit: a repository that lacks the
# tag would otherwise add -g<commit>, or a + with LOCALVERSION unset.
"$src/scripts/config" --file "$src/.config" \
	--disable SECURITY_LOCKDOWN_LSM --disable MODULE_SIG --disable LOCALVERSION_AUTO
# In the source tree, not O=: an out-of-tree build adds
# --remap-path-scope=macro, which rustc takes once, and Rust debug info then
# keeps the absolute build directory. The map strips the tree's parent: a
# map of "$src/" misses the compile directory, "$src" itself, which the
# build ID then hashes.
parent=$(dirname "$src")
make=(make --no-print-directory --directory="$src"
	KBUILD_BUILD_TIMESTAMP="@$(git -C "$src" log --max-count=1 --format=%ct)"
	KBUILD_BUILD_USER=kdevops KBUILD_BUILD_HOST=kdevops KBUILD_BUILD_VERSION=1 LOCALVERSION=
	KCFLAGS="-ffile-prefix-map=$parent/=" KAFLAGS="-ffile-prefix-map=$parent/="
	KRUSTFLAGS="--remap-path-prefix=$parent/=")
"${make[@]}" olddefconfig
"${make[@]}" --jobs="$(nproc)"
"${make[@]}" INSTALL_MOD_PATH="$dir/out" INSTALL_MOD_STRIP=1 modules_install
release=$("${make[@]}" --silent kernelrelease)
cp "$src/$("${make[@]}" --silent image_name)" "$dir/out/bzImage"
cp "$src/.config" "$dir/out/config"
rm --force "$dir/out/lib/modules/$release/build"

kernel=$(nix store add-path --name "linux-$release" "$dir/out")
nix build "$kernel" --out-link "$index/kernel-$identity"
echo "kernel=$kernel" >>"$output"
