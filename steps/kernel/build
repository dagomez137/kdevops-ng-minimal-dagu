#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/kernel/build --src SRC --flags FILE --dir DIR --index INDEX
##            --output FILE
##
## Build the configured Linux tree SRC in place with the make arguments in
## FILE (steps/kernel/flags), changes to tracked files included, gather the
## image and the modules in DIR/out, add them to the Nix store, keep them as
## INDEX/kernel-<identity> and append kernel=<store path> to FILE. The
## identity hashes all that fixes the bytes: the tree, its .config, the make
## arguments less the host's paths, this script and the devShell's PATH,
## which names the toolchain; a kernel already under INDEX is not built
## again. Run it in the kernel devShell:
##
##   nix develop --ignore-env --keep-env-var HOME .#kernel \
##       --command steps/kernel/build \
##       --src ~/.local/state/kdevops-ng-minimal-dagu/src/linux \
##       --flags ~/.local/state/kdevops-ng-minimal-dagu/linux.flags \
##       --dir ~/.local/state/kdevops-ng-minimal-dagu/linux \
##       --index ~/.local/state/kdevops-ng-minimal-dagu/index --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--src | --flags | --dir | --index | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${src:?} ${flags:?} ${dir:?} ${index:?} ${output:?}"

set -o xtrace
# The tree as git would commit it now, without touching the real index.
staging=$(mktemp)
cp "$(git -C "$src" rev-parse --path-format=absolute --git-path index)" "$staging"
GIT_INDEX_FILE=$staging git -C "$src" add --update
tree=$(GIT_INDEX_FILE=$staging git -C "$src" write-tree)
rm "$staging"
mapfile -t args <"$flags"
# ccache and where the tree lives change no byte of the build.
identity=$(printf '%s\n' "$tree" "$(sha256sum <"$src/.config")" "$(sha256sum <"$0")" "$PATH" \
	"$(grep --invert-match '^CCACHE_' "$flags" | sed "s|$(dirname "$src")|<tree>|g; s|^CC=ccache |CC=|")" |
	sha256sum | cut --characters=1-16)
if kernel=$(readlink --canonicalize-existing "$index/kernel-$identity"); then
	echo "kernel=$kernel" >>"$output"
	exit 0
fi

rm --recursive --force "$dir"
mkdir --parents "$dir/out"
make=(make --no-print-directory --directory="$src" "${args[@]}")
"${make[@]}" --jobs="$(nproc)"
"${make[@]}" INSTALL_MOD_PATH="$dir/out" INSTALL_MOD_STRIP=1 modules_install
release=$("${make[@]}" --silent kernelrelease)
cp "$src/$("${make[@]}" --silent image_name)" "$dir/out/bzImage"
cp "$src/.config" "$dir/out/config"
rm --force "$dir/out/lib/modules/$release/build"

kernel=$(nix store add-path --name "linux-$release" "$dir/out")
nix build "$kernel" --out-link "$index/kernel-$identity"
echo "kernel=$kernel" >>"$output"
