#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/nix/closure --flake FLAKE --fstests TREE --dir DIR --output FILE
##
## Build the guest's NixOS system closure from FLAKE, with fstests
## built from the git TREE as it stands, uncommitted changes included, or
## FLAKE's pinned fstests when TREE is empty; keep it as DIR/toplevel and
## append init=<path> and initrd=<path> from its bootspec to FILE:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/nix/closure --flake . \
##       --fstests ~/src/reproducer-generic-127/xfstests \
##       --dir ~/.local/state/kdevops-ng-minimal-dagu/closure --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--flake | --fstests | --dir | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${flake:?} ${fstests?} ${dir:?} ${output:?}"

set -o xtrace
mkdir --parents "$dir"
override=()
if [ -n "$fstests" ]; then
	override=(--override-input xfstests-src "git+file://$fstests")
fi
nix build "$flake#nixosConfigurations.guest.config.system.build.toplevel" \
	"${override[@]}" --out-link "$dir/toplevel"
jq --raw-output '."org.nixos.bootspec.v1" | "init=\(.init)", "initrd=\(.initrd)"' \
	"$dir/toplevel/boot.json" >>"$output"
