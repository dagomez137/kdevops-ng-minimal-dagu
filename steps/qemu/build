#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/qemu/build --url URL --ref REF --dir DIR --output FILE
##
## Clone REF of URL into DIR/src, build the x86_64 system emulator in
## DIR/build, install it into DIR/install and append qemu=<binary> to FILE.
## Run it in the qemu devShell:
##
##   nix develop .#qemu --command steps/qemu/build \
##       --url https://gitlab.com/qemu-project/qemu.git --ref v11.1.2 \
##       --dir ~/.local/state/kdevops-ng-minimal-dagu/qemu --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--url | --ref | --dir | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${url:?} ${ref:?} ${dir:?} ${output:?}"

set -o xtrace
rm --recursive --force "$dir"
git clone --depth 1 --branch "$ref" "$url" "$dir/src"
meson subprojects download --sourcedir "$dir/src"
mkdir --parents "$dir/build"
cd "$dir/build"
"$dir/src/configure" --target-list=x86_64-softmmu --prefix="$dir/install" \
	--disable-download
make -j"$(nproc)"
make install
echo "qemu=$dir/install/bin/qemu-system-x86_64" >>"$output"
