#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/qemu/build --src SRC --dir DIR --output FILE
##
## Build the x86_64 system emulator of the QEMU tree SRC in DIR/build,
## install it into DIR/install and append qemu=<binary> to FILE. Run it in
## the qemu devShell:
##
##   nix develop --ignore-env --keep-env-var HOME .#qemu \
##       --command steps/qemu/build \
##       --src ~/.local/state/kdevops-ng-minimal-dagu/src/qemu \
##       --dir ~/.local/state/kdevops-ng-minimal-dagu/qemu --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--src | --dir | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${src:?} ${dir:?} ${output:?}"

set -o xtrace
rm --recursive --force "$dir"
meson subprojects download --sourcedir "$src"
mkdir --parents "$dir/build"
cd "$dir/build"
"$src/configure" --target-list=x86_64-softmmu --prefix="$dir/install" \
	--disable-download
make --jobs="$(nproc)"
make install
echo "qemu=$dir/install/bin/qemu-system-x86_64" >>"$output"
