#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/qemu/build --src SRC --dir DIR --output FILE
##
## Build the x86_64 system emulator of the QEMU tree SRC, changes to
## tracked files included, in DIR/build, install it into DIR/install and
## append qemu=<binary> to FILE. DIR/build stays for the next build to go on
## from, and an install whose identity (the tree, this script and the
## devShell's PATH, which names the toolchain) matches is not built again.
## Run it in the qemu devShell:
##
##   nix develop --ignore-env --keep-env-var HOME .#qemu \
##       --command steps/qemu/build \
##       --src ~/.local/state/kdevops-ng-minimal-dagu/src/qemu \
##       --dir ~/.local/state/kdevops-ng-minimal-dagu/qemu --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--src | --dir | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${src:?} ${dir:?} ${output:?}"

set -o xtrace
# The tree as git would commit it now, without touching the real index.
staging=$(mktemp)
cp "$(git -C "$src" rev-parse --path-format=absolute --git-path index)" "$staging"
GIT_INDEX_FILE=$staging git -C "$src" add --update
tree=$(GIT_INDEX_FILE=$staging git -C "$src" write-tree)
rm "$staging"
setup=$(printf '%s\n' "$(sha256sum <"$0")" "$PATH" | sha256sum | cut --characters=1-16)
identity=$(printf '%s\n' "$tree" "$setup" | sha256sum | cut --characters=1-16)
qemu=$dir/install/bin/qemu-system-x86_64
if [ -x "$qemu" ] && [ "$(cat "$dir/install/identity")" = "$identity" ]; then
	echo "qemu=$qemu" >>"$output"
	exit 0
fi

# A build directory configured by another script or toolchain starts over.
if [ "$(cat "$dir/build/setup" 2>/dev/null)" != "$setup" ]; then
	rm --recursive --force "$dir"
	meson subprojects download --sourcedir "$src"
	mkdir --parents "$dir/build"
	(
		cd "$dir/build"
		"$src/configure" --target-list=x86_64-softmmu --prefix="$dir/install" \
			--disable-download
	)
	echo "$setup" >"$dir/build/setup"
fi
make --directory="$dir/build" --jobs="$(nproc)"
make --directory="$dir/build" install
echo "$identity" >"$dir/install/identity"
echo "qemu=$qemu" >>"$output"
