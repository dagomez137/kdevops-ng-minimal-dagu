#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/qsu/render --name VM --qemu BINARY --virtiofsd BINARY
##            --kernel PATH --init PATH --initrd PATH --state DIR --qsu DIR
##
## Write the qemu-system@VM.service unit, its virtiofsd shares and NVMe
## drives from the qemu-system-units checkout QSU into ~/.config/systemd.
## The guest boots KERNEL (its image and modules) with the NixOS INIT and
## INITRD, and gets three shares: the Nix store, the kernel's modules and
## DIR/xfstests. DIR is the unit's state directory and also holds the vars
## file and the NVMe drives:
##
##   nix develop --ignore-env --keep-env-var HOME --keep-env-var XDG_RUNTIME_DIR \
##       --command steps/qsu/render --name fstests \
##       --qemu ~/.local/state/kdevops-ng-minimal-dagu/qemu/install/bin/qemu-system-x86_64 \
##       --virtiofsd ~/.local/state/kdevops-ng-minimal-dagu/virtiofsd/bin/virtiofsd \
##       --kernel /nix/store/...-linux-7.2.11 --init /nix/store/...-nixos-system-.../init \
##       --initrd /nix/store/...-initrd-linux/initrd \
##       --state ~/.local/state/qemu-system/fstests --qsu vendor/qemu-system-units
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --qemu | --virtiofsd | --kernel | --init | --initrd | --state | --qsu)
		declare "${1#--}=$2"
		;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?} ${qemu:?} ${virtiofsd:?} ${kernel:?} ${init:?} ${initrd:?} ${state:?} ${qsu:?}"

set -o xtrace
mkdir --parents "$state"
vars=$state/vars.json
jq --null-input --arg name "$name" --arg qemu "$qemu" --arg virtiofsd "$virtiofsd" \
	--arg kernel "$kernel" --arg init "$init" --arg initrd "$initrd" --arg state "$state" '{
	vm_name: $name,
	qemu_binary: $qemu,
	virtiofsd_binary: $virtiofsd,
	machine_type: "q35",
	ram: 4096,
	cpus: 4,
	kernel: {
		image: "\($kernel)/bzImage",
		append: "root=tmpfs console=ttyS0,115200 init=\($init)",
		initrd: $initrd
	},
	shares: [
		{tag: "store", dir: "/nix/store"},
		{tag: "modules", dir: "\($kernel)/lib/modules"},
		{tag: "xfstests", dir: "\($state)/xfstests"}
	],
	nvme: {drives: [
		{file: "\($state)/nvme0.raw", format: "raw"},
		{file: "\($state)/nvme1.raw", format: "raw"}
	]}
}' >"$vars"

units=$HOME/.config/systemd
mkdir --parents "$units/user/qemu-system@$name.service.d" "$units/qemu-system" \
	"$units/virtiofsd"
minijinja-cli --trim-blocks --output "$units/user/qemu-system@$name.service.d/override.conf" \
	"$qsu/templates/qemu-system-override.conf.j2" "$vars"
minijinja-cli --trim-blocks --output "$units/qemu-system/$name.env" \
	"$qsu/templates/vm.env.j2" "$vars"
cp "$qsu/files/qmp-powerdown" "$units/qemu-system/qmp-powerdown"
# The three templates are shared by every VM of this user: keep the ones
# already installed.
for unit in qemu-system@.service virtiofsd@.socket virtiofsd@.service; do
	if [ ! -e "$units/user/$unit" ]; then
		minijinja-cli --trim-blocks --output "$units/user/$unit" \
			"$qsu/templates/$unit.j2" "$vars"
	fi
done
for tag in store modules xfstests; do
	mkdir --parents "$units/user/virtiofsd@$name-$tag.service.d"
	minijinja-cli --trim-blocks --define share_tag="$tag" \
		--output "$units/virtiofsd/$name-$tag.env" \
		"$qsu/templates/virtiofsd.env.j2" "$vars"
	minijinja-cli --trim-blocks \
		--output "$units/user/virtiofsd@$name-$tag.service.d/override.conf" \
		"$qsu/templates/virtiofsd-override.conf.j2" "$vars"
done
systemctl --user daemon-reload
