#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/qsu/render --name VM --cpus N --ram MIB --qemu BINARY
##            --virtiofsd BINARY --kernel PATH --init PATH --initrd PATH
##            --logical-block-size BYTES --physical-block-size BYTES
##            --atomic-nawun N --atomic-nawupf N
##            --key FILE --state DIR --qsu DIR --output FILE
##
## Write the qemu-system@VM.service unit, its virtiofsd shares and NVMe
## drives from the qemu-system-units checkout QSU into ~/.config/systemd.
## The guest has N CPUs and MIB MiB of memory, boots KERNEL (its image and
## modules) with the NixOS INIT and INITRD, and gets five shares: the Nix
## store, the kernel's modules and DIR/{xfstests,selftests,usertests} for the
## suites, three NVMe drives of the logical and physical block sizes whose
## namespaces have QEMU's atomic.nawun and atomic.nawupf, the largest atomic
## write in logical blocks, 0's based (Linux reads only NAWUPF; 0 for none),
## and a vsock device. Root in the guest accepts the SSH key FILE, handed over as
## the ssh.authorized_keys.root credential on the kernel command line. DIR is
## the unit's state directory and also holds the vars file and the NVMe
## drives. A kernel panic reboots the guest at once (panic=-1), which under
## -no-reboot ends QEMU; an oops, or a task blocked for 300 s, panics, as
## no signal reaches a task in uninterruptible sleep and only a reboot
## frees what it holds. Append cid=<vsock CID> to FILE:
##
##   nix develop --ignore-env --keep-env-var HOME --keep-env-var XDG_RUNTIME_DIR \
##       --command steps/qsu/render --name fstests-1 --cpus 4 --ram 4096 \
##       --qemu ~/.local/state/kdevops-ng-minimal-dagu/qemu/install/bin/qemu-system-x86_64 \
##       --virtiofsd ~/.local/state/kdevops-ng-minimal-dagu/virtiofsd/bin/virtiofsd \
##       --kernel /nix/store/...-linux-7.2.11 --init /nix/store/...-nixos-system-.../init \
##       --initrd /nix/store/...-initrd-linux/initrd \
##       --logical-block-size 4096 --physical-block-size 4096 \
##       --atomic-nawun 3 --atomic-nawupf 3 \
##       --key ~/.local/state/kdevops-ng-minimal-dagu/ssh/id_ed25519 \
##       --state ~/.local/state/qemu-system/fstests-1 --qsu vendor/qemu-system-units \
##       --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--name | --cpus | --ram | --qemu | --virtiofsd | --kernel | --init | --initrd | \
		--logical-block-size | --physical-block-size | --atomic-nawun | --atomic-nawupf | \
		--key | --state | --qsu | --output)
		opt=${1#--}
		declare "${opt//-/_}=$2"
		;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${name:?} ${cpus:?} ${ram:?} ${qemu:?} ${virtiofsd:?} ${kernel:?} ${init:?} ${initrd:?} ${key:?}"
: "${logical_block_size:?} ${physical_block_size:?} ${atomic_nawun:?} ${atomic_nawupf:?}"
: "${state:?} ${qsu:?} ${output:?}"
# QEMU takes block sizes that are powers of two from 512 B to 2 MiB, the
# physical no smaller than the logical, but says so only once the unit
# starts.
for size in logical_block_size physical_block_size; do
	if ! [[ ${!size} =~ ^[0-9]+$ ]] || [ "${!size}" -lt 512 ] || [ "${!size}" -gt 2097152 ] ||
		[ $((${!size} & (${!size} - 1))) -ne 0 ]; then
		echo "--${size//_/-} takes a power of two from 512 to 2097152, not '${!size}'" >&2
		exit 2
	fi
done
if [ "$physical_block_size" -lt "$logical_block_size" ]; then
	echo "--physical-block-size $physical_block_size is below --logical-block-size $logical_block_size" >&2
	exit 2
fi

set -o xtrace
# kdevops-ng's f/qsu/common.py: 100 plus the name's SHA-256 modulo 9973.
hash=$(printf '%s' "$name" | sha256sum)
cid=$((100 + 16#${hash:0:8} % 9973))
credential=$(base64 --wrap=0 "$key.pub")
# virtiofsd refuses to start on a missing shared directory, and the VM with it.
mkdir --parents "$state/xfstests" "$state/selftests" "$state/usertests"
vars=$state/vars.json
jq --null-input --arg name "$name" --arg qemu "$qemu" --arg virtiofsd "$virtiofsd" \
	--arg kernel "$kernel" --arg init "$init" --arg initrd "$initrd" --arg state "$state" \
	--argjson cpus "$cpus" --argjson ram "$ram" --argjson cid "$cid" \
	--argjson lbs "$logical_block_size" --argjson pbs "$physical_block_size" \
	--argjson nawun "$atomic_nawun" --argjson nawupf "$atomic_nawupf" \
	--arg credential "$credential" '{
	vm_name: $name,
	qemu_binary: $qemu,
	virtiofsd_binary: $virtiofsd,
	machine_type: "q35",
	ram: $ram,
	cpus: $cpus,
	kernel: {
		image: "\($kernel)/bzImage",
		append: "root=tmpfs console=ttyS0,115200 panic=-1 oops=panic hung_task_panic=1 sysctl.kernel.hung_task_timeout_secs=300 init=\($init) systemd.set_credential_binary=ssh.authorized_keys.root:\($credential)",
		initrd: $initrd
	},
	shares: [
		{tag: "store", dir: "/nix/store"},
		{tag: "modules", dir: "\($kernel)/lib/modules"},
		{tag: "xfstests", dir: "\($state)/xfstests"},
		{tag: "selftests", dir: "\($state)/selftests"},
		{tag: "usertests", dir: "\($state)/usertests"}
	],
	nvme: {drives: [range(3) | {namespaces: [{
		file: "\($state)/nvme\(.).raw",
		format: "raw",
		logical_block_size: $lbs,
		physical_block_size: $pbs,
		"atomic.nawun": $nawun,
		"atomic.nawupf": $nawupf
	}]}]},
	vsock_cid: $cid,
	extra_qemu_args: "-no-reboot"
}' >"$vars"

units=$HOME/.config/systemd
mkdir --parents "$units/user/qemu-system@$name.service.d" "$units/qemu-system" \
	"$units/virtiofsd"
minijinja-cli --trim-blocks --output "$units/user/qemu-system@$name.service.d/override.conf" \
	"$qsu/templates/qemu-system-override.conf.j2" "$vars"
minijinja-cli --trim-blocks --output "$units/qemu-system/$name.env" \
	"$qsu/templates/vm.env.j2" "$vars"
# The helper and the three templates are shared by every VM of this user,
# and guests render side by side: each lands under a name of this VM's and
# is renamed into place, so two writers never meet in one file. Templates
# already installed are kept.
cp "$qsu/files/qmp-powerdown" "$units/qemu-system/qmp-powerdown.$name"
mv --force "$units/qemu-system/qmp-powerdown.$name" "$units/qemu-system/qmp-powerdown"
for unit in qemu-system@.service virtiofsd@.socket virtiofsd@.service; do
	if [ ! -e "$units/user/$unit" ]; then
		minijinja-cli --trim-blocks --output "$units/user/$unit.$name" \
			"$qsu/templates/$unit.j2" "$vars"
		mv --force "$units/user/$unit.$name" "$units/user/$unit"
	fi
done
for tag in store modules xfstests selftests usertests; do
	mkdir --parents "$units/user/virtiofsd@$name-$tag.service.d"
	minijinja-cli --trim-blocks --define share_tag="$tag" \
		--output "$units/virtiofsd/$name-$tag.env" \
		"$qsu/templates/virtiofsd.env.j2" "$vars"
	minijinja-cli --trim-blocks \
		--output "$units/user/virtiofsd@$name-$tag.service.d/override.conf" \
		"$qsu/templates/virtiofsd-override.conf.j2" "$vars"
done
systemctl --user daemon-reload
echo "cid=$cid" >>"$output"
