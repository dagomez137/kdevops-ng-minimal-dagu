#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/qsu/ssh --key FILE --cid CID [--connect-timeout SEC] -- COMMAND...
##
## Run COMMAND as root in the guest whose vsock CID is CID, over SSH with the
## private key FILE: kdevops-ng's RemoteSystemd argv (f/common/remote.py),
## through systemd's systemd-ssh-proxy and no SSH configuration file. A
## guest that stops answering for five minutes ends the command with ssh's
## status 255:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/qsu/ssh \
##       --key ~/.local/state/kdevops-ng-minimal-dagu/ssh/id_ed25519 \
##       --cid 4242 -- systemctl is-system-running
set -o errexit -o nounset -o pipefail

connect_timeout=10
while [ $# -gt 0 ]; do
	case $1 in
	--key | --cid | --connect-timeout)
		opt=${1#--}
		declare "${opt//-/_}=$2"
		shift 2
		;;
	--)
		shift
		break
		;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
done
: "${key:?} ${cid:?}"
[ $# -gt 0 ] || { sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2; }

set -o xtrace
proxy=$(realpath "$(command -v systemctl)")
proxy=${proxy%/bin/systemctl}/lib/systemd/systemd-ssh-proxy
exec ssh -F /dev/null -o LogLevel=ERROR \
	-o "ProxyCommand=$proxy %h %p" -o ProxyUseFdpass=yes \
	-o "IdentityFile=$key" -o IdentitiesOnly=yes -o User=root \
	-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null \
	-o BatchMode=yes -o "ConnectTimeout=$connect_timeout" \
	-o ServerAliveInterval=60 -o ServerAliveCountMax=5 \
	"vsock/$cid" "$@"
