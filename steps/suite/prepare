#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: steps/suite/prepare --suite selftests|usertests --build MANIFEST
##            --share DIR --kver RELEASE --timeout SEC --only ITEMS --output FILE
##
## Lay the suite's tree, which the build MANIFEST names (steps/kernel/selftests
## or usertests), out on the guest's share DIR as DIR/RELEASE/tree, writable,
## as the tests write beside themselves and the store is read-only, and
## append unit=<its unit template> and items=<what steps/suite/run runs:
## ITEMS, or all the tree has when empty> to FILE. kselftest runs
## collections, its runner killing a test after SEC seconds when SEC is not
## 0 (each collection's settings otherwise); usertests runs programs,
## memblock's with --verbose for its per-test lines. kdevops-ng's
## f/selftests and f/usertests prepare and render_config:
##
##   nix develop --ignore-env --keep-env-var HOME \
##       --command steps/suite/prepare --suite selftests \
##       --build ~/.local/state/kdevops-ng-minimal-dagu/build.env \
##       --share ~/.local/state/qemu-system/selftests-1/selftests \
##       --kver 7.3.0 --timeout 0 --only '' --output /dev/stdout
set -o errexit -o nounset -o pipefail

while [ $# -gt 0 ]; do
	case $1 in
	--suite | --build | --share | --kver | --timeout | --only | --output) declare "${1#--}=$2" ;;
	*) sed --quiet 's/^## \{0,1\}//p' "$0" >&2 && exit 2 ;;
	esac
	shift 2
done
: "${suite:?} ${build:?} ${share:?} ${kver:?} ${timeout:?} ${only?} ${output:?}"

set -o xtrace
store=$(sed --quiet "s/^$suite=//p" "$build")
test -d "$store/" || { echo "$build names no $suite tree; build it first" >&2 && exit 1; }
tree=$share/$kver/tree
rm --recursive --force "$tree"
mkdir --parents "$tree"
cp --archive "$store/." "$tree"
chmod --recursive u+w "$tree"
case $suite in
selftests)
	unit=kselftest
	if [ "$timeout" -gt 0 ]; then
		echo "KSELFTEST_ARGS=--override-timeout $timeout" >"$share/kselftest.env"
	else
		echo "KSELFTEST_ARGS=" >"$share/kselftest.env"
	fi
	# kselftest-list.txt names collection:test, and a collection can hold
	# a slash.
	items=$(cut --delimiter=: --fields=1 "$tree/kselftest-list.txt" | awk '!seen[$0]++' |
		paste --serial --delimiters=' ')
	;;
usertests)
	unit=usertests
	items=$(grep / "$tree/MANIFEST" | paste --serial --delimiters=' ')
	for item in $items; do
		mkdir --parents "$share/$kver/env/$(dirname "$item")"
		case $item in
		memblock/main) echo "ARGS=--verbose" ;;
		*) echo "ARGS=" ;;
		esac >"$share/$kver/env/$item.env"
	done
	;;
*)
	echo "no suite $suite" >&2
	exit 2
	;;
esac
{
	echo "unit=$unit"
	echo "items=${only:-$items}"
} >>"$output"
